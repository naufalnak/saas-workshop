// prisma/schema.prisma

generator client {
  provider   = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ─── ENUMS ───────────────────────────────────────────────

enum OrderType {
  BOOKING
  WALK_IN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  REJECTED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  OWNER
  ADMIN
  MECHANIC
}

enum ServiceStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
}

// ─── MODELS ──────────────────────────────────────────────

// RateLimit sudah tidak dipakai (pindah ke Redis)
// Tabel ini bisa di-drop via migration terpisah

model BookingRequest {
  id            String        @id @default(uuid())
  complaint     String
  preferredDate DateTime?
  status        BookingStatus @default(PENDING)
  workshopId    String
  customerId    String
  vehicleId     String?
  notes         String?
  rejectReason  String?
  createdAt     DateTime      @default(now())

  workshop  Workshop  @relation(fields: [workshopId], references: [id])
  customer  Customer  @relation(fields: [customerId], references: [id])
  vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id])
  service   Service?

  @@index([workshopId])
  @@index([customerId])
}

model Workshop {
  id          String   @id @default(uuid())
  name        String
  phone       String?
  address     String?
  city        String?
  logoUrl     String?
  slug        String?  @unique
  description String?
  openHour    String?
  closeHour   String?
  isPublished Boolean  @default(false)
  specialties String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users            User[]
  bookingRequests  BookingRequest[]
  customers        Customer[]
  vehicles         Vehicle[]
  services         Service[]
  invoices         Invoice[]
  payments         Payment[]
  workshopServices WorkshopService[]
  orders           Order[]

  // Index untuk query publik (filter isPublished)
  @@index([isPublished])
}

model WorkshopService {
  id          String   @id @default(uuid())
  name        String
  description String?
  priceMin    Int?
  priceMax    Int?
  duration    Int?
  workshopId  String
  createdAt   DateTime @default(now())

  workshop    Workshop @relation(fields: [workshopId], references: [id])

  @@index([workshopId])
}

model GlobalCustomer {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  password        String
  phone           String?
  emailVerified   Boolean   @default(false)
  verifyToken     String?
  verifyTokenExp  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  orders    Order[]
}

model Order {
  id               String      @id @default(uuid())
  orderNo          String      @unique
  type             OrderType
  status           OrderStatus @default(PENDING)
  complaint        String
  notes            String?
  preferredDate    DateTime?
  guestName        String?
  guestPhone       String?
  workshopId       String
  globalCustomerId String?
  vehicleId        String?
  serviceId        String?     @unique
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  workshop        Workshop        @relation(fields: [workshopId], references: [id])
  globalCustomer  GlobalCustomer? @relation(fields: [globalCustomerId], references: [id])
  vehicle         Vehicle?        @relation(fields: [vehicleId], references: [id])
  service         Service?        @relation(fields: [serviceId], references: [id])

  @@index([workshopId])
  @@index([workshopId, status]) // filter by status di dashboard bookings
  @@index([globalCustomerId])   // lookup order by customer
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  password        String
  role            UserRole  @default(MECHANIC)
  workshopId      String
  emailVerified   Boolean   @default(false)
  verifyToken     String?
  verifyTokenExp  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workshop   Workshop  @relation(fields: [workshopId], references: [id])
  services   Service[]

  @@index([workshopId]) // getMechanicsForSelect filter by workshopId
}

model Customer {
  id         String   @id @default(uuid())
  name       String
  phone      String?
  email      String?
  address    String?
  workshopId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workshop        Workshop         @relation(fields: [workshopId], references: [id])
  vehicles        Vehicle[]
  bookingRequests BookingRequest[]

  @@index([workshopId])
  @@index([workshopId, email]) // lookup customer by email saat booking
}

model Vehicle {
  id          String   @id @default(uuid())
  plateNumber String
  brand       String
  model       String
  year        Int?
  color       String?
  engineCC    Int?
  workshopId  String
  customerId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workshop        Workshop         @relation(fields: [workshopId], references: [id])
  customer        Customer         @relation(fields: [customerId], references: [id])
  services        Service[]
  bookingRequests BookingRequest[]
  orders          Order[]

  @@index([workshopId])
  @@index([customerId]) // load vehicles by customer
}

model Service {
  id               String        @id @default(uuid())
  serviceNo        String        @unique
  complaint        String
  diagnosis        String?
  notes            String?
  status           ServiceStatus @default(PENDING)
  workshopId       String
  vehicleId        String
  mechanicId       String?
  bookingRequestId String?       @unique
  startDate        DateTime      @default(now())
  endDate          DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  workshop       Workshop        @relation(fields: [workshopId], references: [id])
  vehicle        Vehicle         @relation(fields: [vehicleId], references: [id])
  mechanic       User?           @relation(fields: [mechanicId], references: [id])
  serviceItems   ServiceItem[]
  invoice        Invoice?
  bookingRequest BookingRequest? @relation(fields: [bookingRequestId], references: [id])
  order          Order?

  @@index([workshopId])
  @@index([workshopId, status]) // filter by status di dashboard services
  @@index([vehicleId])
  @@index([mechanicId])         // filter service by mechanic
}

model ServiceItem {
  id          String   @id @default(uuid())
  name        String
  description String?
  qty         Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  serviceId   String
  createdAt   DateTime @default(now())

  service     Service @relation(fields: [serviceId], references: [id])

  @@index([serviceId])
}

model Invoice {
  id          String        @id @default(uuid())
  invoiceNo   String        @unique
  subtotal    Decimal       @db.Decimal(12, 2)
  tax         Decimal       @default(0) @db.Decimal(12, 2)
  discount    Decimal       @default(0) @db.Decimal(12, 2)
  total       Decimal       @db.Decimal(12, 2)
  status      InvoiceStatus @default(UNPAID)
  dueDate     DateTime?
  workshopId  String
  serviceId   String        @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workshop    Workshop  @relation(fields: [workshopId], references: [id])
  service     Service   @relation(fields: [serviceId], references: [id])
  payments    Payment[]

  @@index([workshopId])
  @@index([workshopId, status]) // filter invoice UNPAID/PAID di dashboard
}

model Payment {
  id            String        @id @default(uuid())
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod @default(CASH)
  referenceNo   String?
  notes         String?
  workshopId    String
  invoiceId     String
  paidAt        DateTime      @default(now())
  createdAt     DateTime      @default(now())

  workshop      Workshop  @relation(fields: [workshopId], references: [id])
  invoice       Invoice   @relation(fields: [invoiceId], references: [id])

  @@index([workshopId])
  @@index([workshopId, paidAt]) // query laporan by date range
  @@index([invoiceId])
}
